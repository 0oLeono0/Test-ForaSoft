{
  "name": "video-chat-room",
  "version": "0.1.0",
  "private": true,
  "description": "Видеочат-комната до 4 участников: WebRTC mesh, Socket.io, React",
  "type": "module",
  "engines": {
    "node": ">=20.9.0"
  },
  "workspaces": [
    "shared",
    "server",
    "client"
  ],
  "scripts": {
    "dev": "concurrently --names server,client --prefix-colors blue,green npm:server:dev npm:client:dev",
    "server:dev": "node --watch server/src/index.js",
    "client:dev": "npm run dev --workspace @vcr/client",
    "build": "npm run build --workspace @vcr/client",
    "start": "node server/src/index.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --project=!server-integration",
    "test:watch": "vitest --project=!server-integration",
    "test:coverage": "vitest run --coverage --project=!server-integration",
    "test:integration": "vitest run --project=server-integration"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@vitest/coverage-v8": "~3.2.7",
    "concurrently": "^10.0.5",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "jsdom": "^26.1.0",
    "prettier": "^3.9.7",
    "socket.io-client": "^4.8.3",
    "supertest": "^7.2.2",
    "vitest": "~3.2.7"
  }
}
